{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure CMake",
            "type": "shell",
            "command": "cmake -S . -B build -G \"MinGW Makefiles\"",
            "problemMatcher": []
        },
        {
            "label": "Build Engine",
            "type": "shell",
            "command": "cmake --build build --clean-first",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "dependsOn": "Configure CMake"
        }
    ]
}
